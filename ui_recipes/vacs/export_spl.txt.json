{
  "recipe_id": "vacs_export_spl_txt_v1",
  "version": "1.0",
  "tool": "vacs",
  "graph_type": "spl",
  "preconditions": {
    "window_signature": "vacs_main_window",
    "graph_open": "spl"
  },
  "actions": [
    {
      "op": "open_menu_path",
      "selector": {
        "path": "File>Export>Text"
      }
    },
    {
      "op": "set_text",
      "selector": {
        "control_type": "Edit",
        "automation_id": "1001"
      },
      "from_profile_key": "output_file"
    },
    {
      "op": "click",
      "selector": {
        "control_type": "Button",
        "title_regex": "^(Save|OK)$"
      }
    }
  ],
  "required_settings": [
    {
      "key": "delimiter",
      "default": "tab",
      "selector": {
        "control_type": "ComboBox",
        "automation_id": "2001"
      }
    },
    {
      "key": "decimal_separator",
      "default": ".",
      "selector": {
        "control_type": "ComboBox",
        "automation_id": "2002"
      }
    }
  ],
  "expected_output": {
    "file_pattern": "^Result_.*SPL.*\\.txt$",
    "must_exist_within_seconds": 10
  },
  "recovery_actions": [
    {
      "when": {
        "title_regex": "(already exists|overwrite)"
      },
      "actions": [
        {
          "op": "click",
          "selector": {
            "control_type": "Button",
            "title_regex": "^(Yes|OK)$"
          }
        }
      ]
    }
  ]
}
