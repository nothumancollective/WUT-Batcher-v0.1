{
  "contract_id": "akabak_solve_flow_v2",
  "app": "akabak",
  "description": "UIA contract for ABEC import + solve flow (no visual automation).",
  "required_windows": [
    {
      "signature_id": "akabak_main_window",
      "match": {
        "process_name": "akabak.exe",
        "class_name_regex": "(TForm_Main|Qt|QWidget|AKABAK|MainWindow)",
        "control_type": "Window"
      }
    },
    {
      "signature_id": "akabak_interpreter_window",
      "optional": true,
      "match": {
        "process_name": "akabak.exe",
        "class_name_regex": "(TForm_Interpreter)",
        "control_type": "Window"
      }
    },
    {
      "signature_id": "akabak_open_file_dialog",
      "optional": true,
      "match": {
        "process_name": "akabak.exe",
        "class_name_regex": "(#32770)",
        "control_type": "Window"
      },
      "required_controls": [
        {
          "control_type": "Edit",
          "automation_id": "1148",
          "class_name_regex": "(Edit|ComboBox)"
        },
        {
          "control_type": "Button",
          "automation_id": "1"
        }
      ]
    },
    {
      "signature_id": "akabak_solve_progress",
      "optional": true,
      "match": {
        "process_name": "akabak.exe",
        "class_name_regex": "(#32770|Dialog|Qt|TForm_.*)",
        "control_type": "Window"
      }
    }
  ],
  "known_modal_dialogs": [
    {
      "rule_id": "example_files_startup",
      "class_name_regex": "TForm_ExampleFiles",
      "action": "close_window"
    },
    {
      "rule_id": "overwrite_confirm",
      "title_regex": "(warning|confirm|notice)",
      "message_regex": "(overwrite|continue|already exists)",
      "action": "ok"
    }
  ],
  "actions": [
    {
      "step": "open_project",
      "selector_priority": [
        "automation_id",
        "control_type",
        "class_name",
        "native_window_handle",
        "title_regex"
      ],
      "open_dialog_submission_ladder": [
        "Tier A: UIA ValuePattern/set_edit_text on filename Edit + UIA InvokePattern/click on Open button",
        "Tier B: Win32 SetDlgItemText/WM_SETTEXT on Edit + WM_COMMAND(IDOK)/BM_CLICK",
        "Tier C LAST_RESORT: scoped type_keys(path)+Enter only after verified keyboard focus on filename Edit"
      ],
      "postcondition": "open_file_dialog_absent AND project_loaded_signal_present"
    },
    {
      "step": "run_solve",
      "trigger": "F5",
      "completion_signal": "solve_progress_window_disappeared"
    }
  ]
}
