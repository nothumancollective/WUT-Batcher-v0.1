          "1": "OS-SE composed profile (uses Term.*)",

          "3": "circular arc (uses CircArc.*)"

        }

      },

      "group": "HornGeometry",

      "description": "Selects profile family used to generate each radial profile curve.",

      "sources": [

        {

          "source": "Ath 4.8.2 User Guide",

          "section": "4.1.1 Horn geometry (PDF p.18)",

          "quote-hint": "Throat.Profile = 1 ... 1 = OS-SE ... 3 = circular arc"

        }

      ]

    },

