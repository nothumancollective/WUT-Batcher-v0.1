        {

          "source": "Ath 4.8.2 User Guide",

          "section": "4.1.1 Horn geometry (PDF p.18)",

          "quote-hint": "Throat.Diameter f Throat diameter [mm]"

        }

      ]

    },

    {

      "key": "Throat.Profile",

